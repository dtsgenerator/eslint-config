{
  "name": "@dtsgenerator/eslint-config",
  "version": "1.0.0",
  "description": "Shared ESLint flat config for dtsgenerator packages.",
  "main": "index.js",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run test:config && npm run lint",
    "test:config": "eslint --print-config fixtures/normal.ts > /dev/null",
    "lint": "eslint \"fixtures/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dtsgenerator/eslint-config.git"
  },
  "keywords": [
    "dtsgenerator",
    "eslint",
    "eslintconfig"
  ],
  "author": "horiuchi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dtsgenerator/eslint-config/issues"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.4.5 <6.1.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "^6.0.3"
  }
}
